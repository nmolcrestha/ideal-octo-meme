# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the checked-in template must stay tracked.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (generated client - recreated by `npm run db:generate`)
/generated

# prisma agent skills (installed by `prisma init`).
# .claude/skills and .windsurf/skills are machine-specific ABSOLUTE symlinks
# into .agents/skills, so they are not portable across clones.
# Remove these lines if you'd rather commit the skill docs.
.claude/skills/
.windsurf/
.agents/
skills-lock.json

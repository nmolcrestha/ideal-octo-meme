# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env
#
# `.env` is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Used by the Prisma CLI (via prisma7.config.ts) and at runtime by the
# driver adapter in lib/prisma.ts.
#
# Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Notes:
#   - URL-encode special characters in the password (e.g. @ -> %40).
#   - Hosted providers (Neon, Supabase, Prisma Postgres, RDS) usually require
#     TLS — append `?sslmode=require` instead of `?schema=public`.
#   - When using a connection pooler (PgBouncer, Supabase port 6543), also add
#     `&pgbouncer=true&connection_limit=1`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ideal_octo_meme?schema=public"

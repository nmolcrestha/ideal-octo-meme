# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env
#
# `.env` is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Used by the Prisma CLI (via prisma7.config.ts) and at runtime by the
# driver adapter in lib/prisma.ts.
#
# Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Notes:
#   - URL-encode special characters in the password (e.g. @ -> %40).
#   - Hosted providers (Neon, Supabase, Prisma Postgres, RDS) usually require
#     TLS — append `?sslmode=require` instead of `?schema=public`.
#   - When using a connection pooler (PgBouncer, Supabase port 6543), also add
#     `&pgbouncer=true&connection_limit=1`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ideal_octo_meme?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signing key for the session JWT stored in the `session` cookie. Rotating it
# invalidates every existing session, which is the intended way to force a
# global sign-out.
#
# Generate one with:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Seed account (optional — see prisma/seed.ts)
# ---------------------------------------------------------------------------
# The credentials `npm run db:seed` creates. Omit to use the defaults:
#   anmol@mandarix.com / sightline123
# The password must pass the strength rules in lib/auth/definitions.ts.
# SEED_USER_EMAIL="you@company.com"
# SEED_USER_PASSWORD="sightline123"
# SEED_USER_NAME="Your Name"

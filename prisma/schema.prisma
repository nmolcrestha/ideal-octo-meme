// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  // Output must live outside `app/` so the Next.js router never scans it.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection URL is supplied by `prisma7.config.ts` (DATABASE_URL),
  // and at runtime by the driver adapter in `lib/prisma.ts`.
}

